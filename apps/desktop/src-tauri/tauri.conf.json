{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K8s IDE",
  "version": "0.0.1",
  "identifier": "dev.k8s-ide.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K8s IDE",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/k8s-ide-backend"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
