{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kubernetes IDE",
  "version": "0.1.0",
  "identifier": "dev.cursor.k8s-ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Kubernetes IDE",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
