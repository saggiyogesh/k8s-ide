{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k8s-ide",
  "version": "0.1.0",
  "identifier": "com.k8s-ide.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "k8s-ide",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/k8s-ide-server"]
  },
  "plugins": {
    "dialog": {},
    "shell": {
      "open": true
    }
  }
}
