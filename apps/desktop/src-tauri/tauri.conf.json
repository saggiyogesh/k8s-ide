{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k8s-ide",
  "version": "0.0.0",
  "identifier": "com.k8s-ide.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "k8s-ide",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/k8s-ide-server": "binaries/k8s-ide-server"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "sidecar": true
    }
  }
}
