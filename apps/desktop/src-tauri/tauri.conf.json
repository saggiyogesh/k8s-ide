{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kubernetes IDE",
  "version": "0.1.0",
  "identifier": "dev.cursor.k8side",
  "build": {
    "beforeDevCommand": "pnpm --dir .. exec vite --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "pnpm --dir .. exec vite build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kubernetes IDE",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
