{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kubernetes IDE",
  "version": "0.1.0",
  "identifier": "dev.cursor.k8side",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "beforeBuildCommand": "pnpm --dir .. build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kubernetes IDE",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
