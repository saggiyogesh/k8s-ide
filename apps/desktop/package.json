{
  "name": "@k8s-ide/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@k8s-ide/app": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "build": "vite build && PATH=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:$PATH RUSTC=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustc RUSTDOC=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustdoc /usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/cargo check --manifest-path src-tauri/Cargo.toml",
    "dev": "tauri dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && PATH=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:$PATH RUSTC=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustc RUSTDOC=/usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rustdoc /usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16"
  }
}
