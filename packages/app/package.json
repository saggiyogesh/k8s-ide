  "devDependencies": {
    "@k8s-ide/eslint-config": "workspace:*",
    "@k8s-ide/tsconfig": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3"
